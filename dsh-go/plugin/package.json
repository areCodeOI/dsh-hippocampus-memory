{
  "name": "local-hippocampus-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "description": "dsh-go 原生界面：海马体记忆状态条、记忆面板、长按消息存入记忆",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "海马体记忆",
      "en": "Hippocampus memory"
    },
    "icon": "book",
    "wants": [
      "message",
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "recall",
          "label": {
            "zh": "回忆",
            "en": "Recall"
          },
          "icon": "search"
        }
      ],
      "message.actions": [
        {
          "id": "save-memory",
          "label": {
            "zh": "存进记忆",
            "en": "Save memory"
          },
          "icon": "save"
        }
      ],
      "session.actions": [
        {
          "id": "replay",
          "label": {
            "zh": "回放记忆",
            "en": "Replay"
          },
          "icon": "replay"
        }
      ],
      "composer.strip": [
        {
          "id": "stats",
          "icon": "book",
          "panel": "memory"
        }
      ],
      "panels": [
        {
          "id": "memory",
          "title": {
            "zh": "海马体记忆",
            "en": "Hippocampus"
          },
          "icon": "book",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  }
}
