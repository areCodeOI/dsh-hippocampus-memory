{
  "name": "dsh-hippocampus-memory",
  "version": "0.7.0",
  "description": "海马体长期记忆：四层 CLS 记忆 + SQLite/PostgreSQL(pgvector) 存储 + REST/MCP + Vue3 WebUI 星图/树 + DSH 侧边栏管理面板 + 权限/审计/嵌入/任务/监控",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "bin": {
    "hippocampus": "bin/hippocampus.mjs",
    "hippocampus-mcp": "bin/hippocampus-mcp.mjs",
    "hippocampus-http": "bin/hippocampus-http.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "bin/",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "LICENSE",
    "web/",
    "webapp/src",
    "webapp/package.json",
    "webapp/vite.config.js",
    "webapp/index.html",
    "webapp/public",
    "dsh-go/"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:smoke": "node test/smoke-runtime.mjs",
    "test:link": "node test/link-install.mjs",
    "test:pg": "node test/pg-integration.mjs",
    "start:mcp": "node bin/hippocampus-mcp.mjs",
    "start:http": "node bin/hippocampus-http.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "hippocampus",
    "mcp",
    "sqlite",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/areCodeOI/dsh-hippocampus-memory.git"
  },
  "homepage": "https://github.com/areCodeOI/dsh-hippocampus-memory#readme",
  "bugs": {
    "url": "https://github.com/areCodeOI/dsh-hippocampus-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "icon": "icon.svg",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "海马体长期记忆",
      "en": "Hippocampus memory"
    },
    "icon": "book",
    "wants": [
      "message",
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "recall",
          "label": {
            "zh": "回忆",
            "en": "Recall"
          },
          "icon": "search"
        }
      ],
      "message.actions": [
        {
          "id": "save-memory",
          "label": {
            "zh": "存进记忆",
            "en": "Save memory"
          },
          "icon": "save"
        }
      ],
      "session.actions": [
        {
          "id": "replay",
          "label": {
            "zh": "回放记忆",
            "en": "Replay"
          },
          "icon": "replay"
        }
      ],
      "composer.strip": [
        {
          "id": "stats",
          "icon": "book",
          "panel": "memory"
        }
      ],
      "panels": [
        {
          "id": "memory",
          "title": {
            "zh": "海马体记忆",
            "en": "Hippocampus"
          },
          "icon": "book",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  }
}
